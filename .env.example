# Konfigurasi Server
PORT=3000

# Pilihan Driver Database: 'mysql' atau 'json'
# Jika 'mysql', server akan menghubungkan ke MySQL Database.
# Jika MySQL tidak aktif atau belum siap, server secara otomatis beralih aman (fallback) ke mode 'json'.
DB_TYPE=mysql

# Konfigurasi MySQL (Contoh default XAMPP / Laragon / MySQL lokal)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=peminjaman_ruangan
